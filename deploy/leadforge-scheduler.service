[Unit]
Description=LeadForge scheduler
After=network-online.target postgresql.service redis.service

[Service]
User=leadforge
Group=leadforge
WorkingDirectory=/opt/leadforge
EnvironmentFile=/etc/leadforge/leadforge.env
ExecStart=/opt/leadforge/bin/scheduler
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
