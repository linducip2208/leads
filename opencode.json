{
    "$schema": "https://opencode.ai/config.json",
    "model": "bai/glm-5.3-flash",
    "provider": {
        "bai": {
            "name": "B.AI",
            "npm": "@ai-sdk/openai-compatible",
            "options": {
                "baseURL": "https://api.b.ai/v1",
                "apiKey": "{env:BAI_API_KEY}"
            },
            "models": {
                "glm-5.3-flash": {
                    "name": "GLM 5.3 Flash"
                }
            }
        }
    },
    "mcp": {
        "laravel-boost": {
            "type": "local",
            "enabled": true,
            "command": [
                "php",
                "artisan",
                "boost:mcp"
            ]
        }
    }
}