# LeadForge local environment. Copy to .env (or export vars) and adjust.
APP_NAME=LeadForge
APP_ENV=local
APP_URL=http://localhost:8080
APP_ADDR=:8080

DATABASE_URL=postgres://postgres@127.0.0.1:5432/leadforge?sslmode=disable
REDIS_ADDR=localhost:6379

# Required in production (APP_ENV=production). Dev default is insecure.
SESSION_SECRET=

# Crawler pool
CRAWLER_WORKERS=20
CRAWLER_DOMAIN_CONCURRENCY=2
CRAWLER_TIMEOUT_S=15
CRAWLER_MAX_PAGES_PER_SITE=10
CRAWLER_MAX_DEPTH=2
CRAWLER_MAX_BODY_MB=5
# Dev/test only: allow crawling private/loopback IPs (E2E fixtures). NEVER true in prod.
CRAWLER_ALLOW_PRIVATE=false

# Pipeline concurrency (no hard-coded worker counts)
SEARCH_PROCESS_WORKERS=8
CRAWLER_SITE_WORKERS=4
CRAWLER_GLOBAL_WORKERS=40
SOURCE_CONCURRENCY=8
ENRICHMENT_WORKERS=10

# Browser fallback (chromedp pool; HTTP-only when Chrome is missing)
BROWSER_ENABLED=true
BROWSER_WORKERS=2
BROWSER_TIMEOUT_S=20
BROWSER_MAX_PAGES=3

# Freshness windows (days)
ENRICHMENT_FRESH_DAYS=30
EMAIL_VERIFY_FRESH_DAYS=30
CRAWL_FRESH_DAYS=14

# Watchdog: fail running searches with no heartbeat for N minutes
WATCHDOG_STALE_MINUTES=15

# Postgres pool
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME_MIN=60

# Tenant guardrail: max concurrent (queued+running+paused) searches
TENANT_MAX_CONCURRENT_SEARCHES=5

# Optional: Google Places discovery stays dormant without a key.
GOOGLE_PLACES_API_KEY=

# AI is optional and OFF by default. The app is fully functional without it.
AI_ENABLED=false

# Shared secret for the inbound email webhook (POST /webhooks/inbound?key=...).
# Empty = open endpoint (dev only); set a random value in production.
INBOUND_WEBHOOK_KEY=

# Outbound mail (used by forgot-password flows later; verification links are logged in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
