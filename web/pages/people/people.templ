package people

import "leadforge/web/components"

templ List(p PageMeta, d *ListData) {
	@components.PageHeader("People", "Decision makers and contacts with verified emails.") { @components.LinkButton("/people/new", "Add Contact") }
	<div class="card bg-white border border-line rounded-xl shadow-xs">
		<form method="get" action="/people" class="px-4 py-3 grid gap-2.5 md:grid-cols-4 border-b border-line bg-[#fafbfd]">
			<input type="search" name="q" value={ d.Filter.Keyword } placeholder="Name or email…" class="input h-8 rounded-lg border border-line bg-white px-2.5 text-[13px] focus:border-brand-400 focus:outline-none"/>
			<input type="text" name="company" value={ d.Filter.Company } placeholder="Company…" class="input h-8 rounded-lg border border-line bg-white px-2.5 text-[13px] focus:border-brand-400 focus:outline-none"/>
			<input type="text" name="title" value={ d.Filter.Title } placeholder="Job title…" class="input h-8 rounded-lg border border-line bg-white px-2.5 text-[13px] focus:border-brand-400 focus:outline-none"/>
			<button class="h-8 px-3 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Filter</button>
		</form>
		<div class="overflow-x-auto">
			<table class="tbl w-full text-[13px]">
				<thead><tr><th>Name</th><th>Company</th><th>Title</th><th>Email</th><th>Status</th><th>Phone</th><th class="text-right">Score</th><th>Source</th></tr></thead>
				<tbody>
					for _, it := range d.Items {
						<tr class="hover:bg-[#f6f7fb] cursor-pointer" data-href={ "/people/" + it.ID }>
							<td class="font-medium max-w-[200px] truncate">{ it.Name }</td>
							<td class="text-ink-2 max-w-[200px] truncate">{ it.Company }</td>
							<td class="text-ink-2 max-w-[180px] truncate">{ it.Title }</td>
							<td class="text-ink-2 max-w-[220px] truncate">{ it.Email }</td>
							<td>@components.StatusBadge(it.EStatus)</td>
							<td class="text-ink-2 whitespace-nowrap">{ it.Phone }</td>
							<td class="text-right">@components.ScoreBadge(it.Score)</td>
							<td class="text-ink-3">{ it.Source }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Items) == 0 {
			<div class="p-10">@components.EmptyState("users", "No contacts yet", "Contacts are extracted automatically when websites are crawled.", components.LinkButton("/finder", "Find Leads"))</div>
		} else if d.HasMore {
			<div class="p-3 text-center border-t border-line">
				<a href={ templ.URL(d.Filter.ListURL(d.NextCursor)) } class="inline-block h-8 px-4 leading-8 rounded-lg border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">Load more</a>
			</div>
		}
	</div>
}

templ Detail(p PageMeta, d *DetailData) {
	@components.PageHeader(d.Name, "Contact profile.")
	<div class="grid gap-4 lg:grid-cols-[1fr_360px] max-w-5xl">
		<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
			<div class="flex items-center gap-3">
				@components.Avatar(d.Name, 44)
				<div>
					<div class="text-[16px] font-semibold">{ d.Name }</div>
					<div class="text-[13px] text-ink-3">{ d.Form.JobTitle }</div>
				</div>
				<span class="ml-auto">@components.ScoreBadge(d.Score)</span>
			</div>
			<div class="mt-4">
				@components.KV("Email", d.Form.Email)
				@components.KV("Phone", d.Form.Phone)
				@components.KV("LinkedIn", d.Form.LinkedIn)
				@components.KV("Company", d.Company)
				@components.KV("Source", d.Source)
				@components.KV("Since", d.Created)
			</div>
			if d.CompanyID != "" {
				<a href={ templ.URL("/companies/" + d.CompanyID) } class="mt-3 inline-block text-[13px] text-brand-600 hover:underline">Open company →</a>
			}
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">Edit contact</h2>
			if d.Form.Error != "" {
				<div class="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-[12.5px] text-red-800">{ d.Form.Error }</div>
			}
			<form method="post" action={ templ.URL("/people/" + d.ID) } class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				<div class="grid grid-cols-2 gap-3">
					@components.Input("first_name", "First name", d.Form.FirstName, "", "text", false)
					@components.Input("last_name", "Last name", d.Form.LastName, "", "text", false)
				</div>
				@components.Input("job_title", "Job title", d.Form.JobTitle, "", "text", false)
				@components.Input("email", "Email", d.Form.Email, "", "email", false)
				@components.Input("phone", "Phone", d.Form.Phone, "", "text", false)
				@components.Input("linkedin_url", "LinkedIn", d.Form.LinkedIn, "", "text", false)
				<button class="h-9 w-full rounded-lg bg-ink text-white text-[13px] font-medium">Save changes</button>
			</form>
		</aside>
	</div>
}

templ New(p PageMeta, d *DetailData) {
	@components.PageHeader("Add Contact", "Create a contact manually.")
	<div class="card bg-white border border-line rounded-xl shadow-xs p-5 max-w-xl">
		if d.Form.Error != "" {
			<div class="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-[12.5px] text-red-800">{ d.Form.Error }</div>
		}
		<form method="post" action="/people" class="space-y-3">
			<input type="hidden" name="_token" value={ p.CSRFToken }/>
			<div class="grid grid-cols-2 gap-3">
				@components.Input("first_name", "First name", d.Form.FirstName, "", "text", false)
				@components.Input("last_name", "Last name", d.Form.LastName, "", "text", false)
			</div>
			@components.Input("job_title", "Job title", d.Form.JobTitle, "", "text", false)
			@components.Input("email", "Email", d.Form.Email, "", "email", false)
			@components.Input("phone", "Phone", d.Form.Phone, "", "text", false)
			<div class="space-y-1.5">
				<label for="company_id" class="block text-[13px] font-medium text-ink-2">Company (optional)</label>
				<select id="company_id" name="company_id" class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px]">
					<option value="">No company</option>
					for _, o := range d.Companies {
						<option value={ o.Value }>{ o.Label }</option>
					}
				</select>
			</div>
			<button class="h-9 px-4 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Create contact</button>
		</form>
	</div>
}
