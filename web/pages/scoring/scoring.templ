package scoring

import "leadforge/web/components"

templ Page(p PageMeta, d *PageData) {
	@components.PageHeader("Lead Scoring", "Rule-based scoring, 0–100. No AI needed — your rules stack on top of the defaults.")
	if d.Error != "" {
		<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-[13px] text-red-800">{ d.Error }</div>
	}
	<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
		<div class="space-y-4">
			<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
				<div class="px-4 py-3 border-b border-line"><h2 class="text-[14px] font-semibold">Your rules</h2></div>
				<table class="tbl w-full text-[13px]">
					<thead><tr><th>Rule</th><th>Signal</th><th>Condition</th><th class="text-right">Points</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
					<tbody>
						for _, r := range d.Custom {
							<tr>
								<td class="font-medium">{ r.Name }</td>
								<td class="text-ink-2">{ r.Signal }</td>
								<td class="text-ink-2">{ condLabel(r) }</td>
								<td class="text-right font-semibold text-emerald-700 tabular-nums">+{ itoa(r.Weight) }</td>
								<td>
									if r.Active {
										@components.Badge("active", "green")
									} else {
										@components.Badge("disabled", "gray")
									}
								</td>
								<td class="text-right whitespace-nowrap">
									<form method="post" action={ templ.URL("/scoring/rules/" + r.ID + "/toggle") } class="inline">
										<input type="hidden" name="_token" value={ p.CSRFToken }/>
										<button class="h-7 px-2 rounded-md border border-line text-[12px] hover:bg-[#f6f7fb]">Toggle</button>
									</form>
									<form method="post" action={ templ.URL("/scoring/rules/" + r.ID + "/delete") } class="inline ml-1" data-confirm="Delete this rule? Scores recalculate on the next search.">
										<input type="hidden" name="_token" value={ p.CSRFToken }/>
										<button class="h-7 px-2 rounded-md border border-line text-[12px] text-red-700 hover:bg-red-50">Delete</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
				if len(d.Custom) == 0 {
					<div class="p-6 text-center text-[13px] text-ink-3">No custom rules — defaults below apply to every lead.</div>
				}
			</div>
			<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
				<div class="px-4 py-3 border-b border-line"><h2 class="text-[14px] font-semibold">Built-in defaults</h2></div>
				<table class="tbl w-full text-[13px]">
					<tbody>
						for _, r := range d.Defaults {
							<tr>
								<td class="font-medium">{ r.Name }</td>
								<td class="text-right font-semibold text-emerald-700 tabular-nums">+{ itoa(r.Weight) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">New rule</h2>
			<form method="post" action="/scoring/rules" class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				@components.Input("name", "Name", "", "e.g. Jakarta bonus", "text", true)
				<div class="space-y-1.5">
					<label class="block text-[13px] font-medium text-ink-2">Signal</label>
					<select name="signal" class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px]">
						<optgroup label="Facts">
							<option value="has_website">Has website</option>
							<option value="has_email">Has email</option>
							<option value="email_verified">Verified email</option>
							<option value="has_phone">Has phone</option>
							<option value="has_whatsapp">Has WhatsApp</option>
							<option value="industry_match">Industry match</option>
							<option value="location_match">Location match</option>
							<option value="employee_match">Employee match</option>
						</optgroup>
						<optgroup label="Text">
							<option value="industry">Industry</option>
							<option value="city">City</option>
							<option value="province">Province</option>
							<option value="country">Country</option>
						</optgroup>
					</select>
				</div>
				<div class="grid grid-cols-2 gap-3">
					@components.Select("operator", "Operator", []string{"exists|Exists", "equals|Equals", "contains|Contains", "in|In list"}, "exists")
					@components.Input("weight", "Points", "10", "", "number", true)
				</div>
				@components.Input("value", "Value (for equals/contains/in)", "", "e.g. jakarta", "text", false)
				<button class="h-9 w-full rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Add rule</button>
			</form>
			<p class="mt-3 text-[12px] text-ink-3">Labels: 0–49 Low · 50–69 Medium · 70–89 Strong · 90–100 Hot.</p>
		</aside>
	</div>
}

func condLabel(r Rule) string {
	if r.Operator == "exists" || r.Value == "" {
		return r.Operator
	}
	return r.Operator + " " + r.Value
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	neg := n < 0
	if neg {
		n = -n
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	if neg {
		i--
		b[i] = '-'
	}
	return string(b[i:])
}
