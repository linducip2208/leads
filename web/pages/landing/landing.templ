package landing

import (
	"strconv"

	"leadforge/web/components"
)

templ Page(d Data) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ d.AppName } — Find customers faster</title>
		<link rel="stylesheet" href="/static/css/app.css"/>
		<script src="/static/js/app.js" defer></script>
		<link rel="icon" href="/static/images/favicon.svg" type="image/svg+xml"/>
	</head>
	<body class="h-full antialiased bg-white text-ink">
		<!-- Nav -->
		<header class="sticky top-0 z-40 bg-white/85 backdrop-blur border-b border-line">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
				<div class="flex items-center gap-2.5">
					<div class="w-7 h-7 rounded-lg bg-brand-600 text-white flex items-center justify-center text-[13px] font-bold">L</div>
					<span class="font-semibold tracking-tight text-[16px]">{ d.AppName }</span>
				</div>
				<nav class="hidden md:flex items-center gap-6 text-[13.5px] text-ink-2">
					<a href="#how" class="hover:text-ink">How it works</a>
					<a href="#features" class="hover:text-ink">Features</a>
					<a href="#pricing" class="hover:text-ink">Pricing</a>
					<a href="#faq" class="hover:text-ink">FAQ</a>
				</nav>
				<div class="flex items-center gap-2">
					<a href="/login" class="h-8.5 inline-flex items-center h-9 px-3 rounded-lg text-[13px] font-medium text-ink-2 hover:text-ink hover:bg-[#f0f1f6]">Sign in</a>
					<a href="/register" class="inline-flex items-center h-9 px-3.5 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700 shadow-xs">Get started</a>
				</div>
			</div>
		</header>

		<!-- Hero -->
		<section class="relative overflow-hidden">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 pt-20 pb-24 text-center">
				<div class="inline-flex items-center gap-2 rounded-full border border-line bg-[#f8f9fc] px-3 py-1 text-[12px] text-ink-2">
					<span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
					Lead discovery, enrichment and CRM in one workspace
				</div>
				<h1 class="mt-6 text-[38px] sm:text-[54px] leading-[1.08] font-semibold tracking-tight">
					Find the right companies.<br/>
					<span class="text-brand-600">Reach the right people.</span><br/>
					Close more deals.
				</h1>
				<p class="mx-auto mt-5 max-w-xl text-[16px] leading-7 text-ink-3">
					Search millions of businesses, enrich them with contacts and scoring,
					and run outreach — without juggling five different tools.
				</p>
				<div class="mt-8 flex items-center justify-center gap-3">
					<a href="/register" class="inline-flex items-center gap-2 h-11 px-5 rounded-lg bg-brand-600 text-white text-[14px] font-medium hover:bg-brand-700 shadow-sm">
						Start finding leads
						@components.Icon("arrow-right", "w-4 h-4")
					</a>
					<a href="/login" class="inline-flex items-center h-11 px-5 rounded-lg border border-line bg-white text-[14px] font-medium text-ink hover:bg-[#f6f7fb]">Sign in</a>
				</div>
				<div class="mt-4 text-[12px] text-ink-3">Free plan available · No credit card required</div>

				<!-- Product preview -->
				<div class="mt-14 rounded-2xl border border-line bg-white shadow-xl shadow-[#1a2340]/5 overflow-hidden text-left">
					<div class="flex items-center gap-1.5 px-4 h-10 border-b border-line bg-[#fafbfd]">
						<span class="w-2.5 h-2.5 rounded-full bg-[#f87171]"></span>
						<span class="w-2.5 h-2.5 rounded-full bg-[#fbbf24]"></span>
						<span class="w-2.5 h-2.5 rounded-full bg-[#34d399]"></span>
						<span class="ml-3 text-[11.5px] text-ink-3">{ d.AppName } — Lead Finder</span>
					</div>
					<div class="grid grid-cols-1 sm:grid-cols-[220px_1fr]">
						<div class="hidden sm:block border-r border-line bg-[#fafbfd] p-3 space-y-1.5">
							@previewRow("layout-dashboard", "Dashboard", true)
							@previewRow("compass", "Lead Finder", false)
							@previewRow("database", "Leads", false)
							@previewRow("kanban", "Pipeline", false)
							@previewRow("megaphone", "Campaigns", false)
						</div>
						<div class="p-4 sm:p-6">
							<div class="h-9 max-w-md rounded-lg border border-brand-300 bg-brand-50/50 flex items-center px-3 gap-2 text-[13px] text-ink-2">
								@components.Icon("search", "w-4 h-4 text-brand-500")
								Construction companies in Jakarta
							</div>
							<div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-2.5">
								@previewStat("Total Leads", "48,210")
								@previewStat("Qualified", "9,720")
								@previewStat("With Email", "22,148")
								@previewStat("Hot", "2,109")
							</div>
							<div class="mt-3 rounded-lg border border-line divide-y divide-[#f0f1f6]">
								@previewLead("PT Maju Konstruksi", "Construction · Jakarta", 92)
								@previewLead("CV Bangun Jaya", "Construction · Bandung", 84)
								@previewLead("PT Graha Persada", "Property · Jakarta", 76)
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- How it works -->
		<section id="how" class="border-t border-line bg-[#f8f9fc]">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
				<h2 class="text-[28px] font-semibold tracking-tight text-center">From search to deal in four steps</h2>
				<p class="mt-3 text-center text-[15px] text-ink-3 max-w-lg mx-auto">Everything happens inside one workspace — no spreadsheets, no copy-paste.</p>
				<div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
					@stepCard("compass", "1 · Discover", "Search by keyword, industry and location. Crawlers visit public pages to collect company data.")
					@stepCard("zap", "2 · Enrich", "Extract emails, phones, socials and technologies. Verify addresses before you hit send.")
					@stepCard("gauge", "3 · Qualify", "Rule-based scoring ranks every lead against your ICP so reps work the best first.")
					@stepCard("megaphone", "4 · Engage", "Move leads into the pipeline and run multi-step email sequences with safety controls.")
				</div>
			</div>
		</section>

		<!-- Features -->
		<section id="features" class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
			<h2 class="text-[28px] font-semibold tracking-tight text-center">Everything a sales team needs</h2>
			<div class="mt-12 grid gap-4 md:grid-cols-3">
				@featureCard("radar", "Lead Finder", "Search-engine style discovery with filters for industry, size, contactability and score.")
				@featureCard("globe", "Compliant crawling", "Bounded worker pools, robots.txt awareness and rate limits on every crawl.")
				@featureCard("users", "Contact enrichment", "Find decision makers with emails and direct phones, with confidence scores.")
				@featureCard("kanban", "Visual CRM", "Kanban pipeline with drag & drop, deal values, owners and activities.")
				@featureCard("mail", "Email sequences", "Multi-step campaigns with per-account limits, suppression and stop-on-reply.")
				@featureCard("brain", "Optional AI", "Bring your own key for summaries and qualification. The app is fully functional without it.")
			</div>
		</section>

		<!-- Pricing -->
		<section id="pricing" class="border-t border-line bg-[#f8f9fc]">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
				<h2 class="text-[28px] font-semibold tracking-tight text-center">Simple, scalable pricing</h2>
				<p class="mt-3 text-center text-[15px] text-ink-3">Start free, upgrade when your pipeline grows.</p>
				<div class="mt-12 grid gap-4 md:grid-cols-3">
					@priceCard("Free", "$0", "For trying LeadForge", []string{"2 users", "3 searches / month", "1,000 leads", "Basic enrichment"}, false)
					@priceCard("Professional", "$149", "Growing sales teams", []string{"10 users", "100 searches / month", "150,000 leads", "Campaigns & API", "AI ready (BYOK)"}, true)
					@priceCard("Business", "$349", "High-volume prospecting", []string{"25 users", "500 searches / month", "1,000,000 leads", "Priority crawling", "White label"}, false)
				</div>
			</div>
		</section>

		<!-- FAQ -->
		<section id="faq" class="max-w-3xl mx-auto px-4 sm:px-6 py-20">
			<h2 class="text-[28px] font-semibold tracking-tight text-center">Frequently asked questions</h2>
			<div class="mt-10 space-y-3">
				@faqItem("Where does the data come from?", "Public business directories, official APIs like Google Places, and the company websites themselves. We respect robots.txt and rate limits, and only collect publicly available business information.")
				@faqItem("Do I need AI to use this?", "No. Scoring, enrichment and CRM work entirely with deterministic rules. AI features are optional and off by default — you can bring your own API key when you want them.")
				@faqItem("Can I import my existing list?", "Yes. CSV and XLSX imports with column mapping and duplicate checking are built in, and exports are always available.")
				@faqItem("Is my data isolated?", "Every record is scoped to your tenant and every query is tenant-filtered. Isolation is covered by automated tests.")
			</div>
		</section>

		<!-- CTA + footer -->
		<footer class="border-t border-line">
			<div class="max-w-6xl mx-auto px-4 sm:px-6 py-14 text-center">
				<h2 class="text-[26px] font-semibold tracking-tight">Ready to build your pipeline?</h2>
				<p class="mt-2 text-[15px] text-ink-3">Create a workspace and run your first search in minutes.</p>
				<a href="/register" class="mt-6 inline-flex items-center gap-2 h-11 px-6 rounded-lg bg-brand-600 text-white text-[14px] font-medium hover:bg-brand-700 shadow-sm">
					Get started free
					@components.Icon("arrow-right", "w-4 h-4")
				</a>
				<div class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-3 text-[12.5px] text-ink-3">
					<span>© 2026 { d.AppName }. All rights reserved.</span>
					<div class="flex items-center gap-4">
						<a href="#how" class="hover:text-ink">Product</a>
						<a href="#pricing" class="hover:text-ink">Pricing</a>
						<a href="/login" class="hover:text-ink">Sign in</a>
					</div>
				</div>
			</div>
		</footer>
	</body>
	</html>
}

templ previewRow(icon, label string, active bool) {
	if active {
		<div class="flex items-center gap-2 rounded-md bg-brand-50 text-brand-700 px-2 py-1.5 text-[12px] font-medium">
			@components.Icon(icon, "w-3.5 h-3.5")
			{ label }
		</div>
	} else {
		<div class="flex items-center gap-2 rounded-md text-ink-2 px-2 py-1.5 text-[12px]">
			@components.Icon(icon, "w-3.5 h-3.5")
			{ label }
		</div>
	}
}

templ previewStat(label, value string) {
	<div class="rounded-lg border border-line p-2.5">
		<div class="text-[10.5px] uppercase tracking-wide text-ink-3">{ label }</div>
		<div class="mt-0.5 text-[17px] font-semibold tabular-nums">{ value }</div>
	</div>
}

templ previewLead(name, sub string, score int) {
	<div class="flex items-center justify-between px-3 py-2.5">
		<div>
			<div class="text-[12.5px] font-medium text-ink">{ name }</div>
			<div class="text-[10.5px] text-ink-3">{ sub }</div>
		</div>
		<span class="rounded-full bg-red-50 border border-red-200 text-red-700 text-[10px] font-medium px-1.5 py-0.5 tabular-nums">{ scoreLabel(score) }</span>
	</div>
}

func scoreLabel(score int) string {
	return strconv.Itoa(score) + " HOT"
}

templ stepCard(icon, title, desc string) {
	<div class="rounded-xl border border-line bg-white p-5 shadow-xs">
		<div class="w-9 h-9 rounded-lg bg-brand-50 text-brand-600 border border-brand-100 flex items-center justify-center">
			@components.Icon(icon, "w-4 h-4")
		</div>
		<h3 class="mt-3 text-[14.5px] font-semibold">{ title }</h3>
		<p class="mt-1.5 text-[13px] leading-6 text-ink-3">{ desc }</p>
	</div>
}

templ featureCard(icon, title, desc string) {
	<div class="rounded-xl border border-line bg-white p-5 shadow-xs">
		<div class="w-9 h-9 rounded-lg bg-brand-50 text-brand-600 border border-brand-100 flex items-center justify-center">
			@components.Icon(icon, "w-4 h-4")
		</div>
		<h3 class="mt-3 text-[14.5px] font-semibold">{ title }</h3>
		<p class="mt-1.5 text-[13px] leading-6 text-ink-3">{ desc }</p>
	</div>
}

templ priceCard(name, price, tagline string, features []string, featured bool) {
	{{ wrap := "rounded-xl border bg-white p-6 shadow-xs" }}
	{{ if featured { wrap += " border-brand-500 ring-2 ring-brand-100" } else { wrap += " border-line" } }}
	<div class={ wrap }>
		if featured {
			<span class="inline-block rounded-full bg-brand-50 border border-brand-200 text-brand-700 text-[11px] font-medium px-2 py-0.5 mb-2">Most popular</span>
		}
		<div class="text-[14px] font-semibold">{ name }</div>
		<div class="mt-1 flex items-baseline gap-1">
			<span class="text-[30px] font-semibold tracking-tight">{ price }</span>
			<span class="text-[13px] text-ink-3">/ month</span>
		</div>
		<p class="mt-1 text-[12.5px] text-ink-3">{ tagline }</p>
		<ul class="mt-4 space-y-2 text-[13px] text-ink-2">
			for _, f := range features {
				<li class="flex items-center gap-2">
					@components.Icon("check", "w-3.5 h-3.5 text-emerald-500")
					{ f }
				</li>
			}
		</ul>
		<a href="/register" class={ btnCls(featured) }>Get started</a>
	</div>
}

func btnCls(featured bool) string {
	if featured {
		return "mt-5 inline-flex w-full justify-center h-9 items-center rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700"
	}
	return "mt-5 inline-flex w-full justify-center h-9 items-center rounded-lg border border-line text-[13px] font-medium text-ink hover:bg-[#f6f7fb]"
}

templ faqItem(q, a string) {
	<details class="group rounded-xl border border-line bg-white px-4 py-3.5 shadow-xs">
		<summary class="cursor-pointer list-none flex items-center justify-between text-[14px] font-medium text-ink">
			{ q }
			<span class="text-ink-3 group-open:rotate-45 transition-transform">
				@components.Icon("plus", "w-4 h-4")
			</span>
		</summary>
		<p class="mt-2.5 text-[13.5px] leading-6 text-ink-2">{ a }</p>
	</details>
}
