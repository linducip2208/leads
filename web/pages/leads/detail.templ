package leads

import "leadforge/web/components"

templ Detail(p PageMeta, d *DetailData) {
	@components.PageHeader(d.Company, d.Industry+" · "+d.Location) { @detailActions(p, d) }
	<div class="grid gap-4 lg:grid-cols-[1fr_360px]">
		<div class="space-y-4 min-w-0">
			<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
				<div class="flex flex-wrap items-center gap-3">
					@components.ScoreBadge(d.Score)
					<span class="text-[13px] text-ink-3">{ d.ScoreLabel } lead</span>
					@components.StatusBadge(d.Status)
					<span class="ml-auto text-[12.5px] text-ink-3">via { d.Source }</span>
				</div>
				if len(d.Breakdown) > 0 {
					<div class="mt-4">
						<div class="text-[12px] font-semibold uppercase tracking-wider text-ink-3 mb-2">Why this score</div>
						<div class="space-y-1.5">
							for _, b := range d.Breakdown {
								<div class="flex items-center justify-between text-[13px]">
									<span class="text-ink-2">{ b.Rule }</span>
									<span class="font-semibold tabular-nums text-emerald-700">+{ itoa(b.Points) }</span>
								</div>
							}
						</div>
					</div>
				}
			</div>

			<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
				<h2 class="text-[14px] font-semibold">Contacts ({ itoa(len(d.Contacts)) })</h2>
				<div class="mt-3 divide-y divide-[#f0f1f6]">
					for _, c := range d.Contacts {
						<div class="py-2.5 flex items-center gap-3">
							@components.Avatar(c.Name, 32)
							<div class="min-w-0 flex-1">
								<div class="text-[13.5px] font-medium truncate">{ c.Name }</div>
								<div class="text-[12px] text-ink-3 truncate">{ c.Title }</div>
							</div>
							<div class="text-right text-[12.5px] shrink-0">
								if c.Email != "" {
									<div><a class="text-brand-600 hover:underline" href={ templ.URL("mailto:" + c.Email) }>{ c.Email }</a></div>
								}
								if c.Phone != "" {
									<div class="text-ink-2">{ c.Phone }</div>
								}
							</div>
						</div>
					}
				</div>
				if len(d.Contacts) == 0 {
					<p class="mt-2 text-[13px] text-ink-3">No contacts extracted yet.</p>
				}
			</div>

			<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
				<h2 class="text-[14px] font-semibold">Activity</h2>
				<div class="mt-3 space-y-3">
					for _, a := range d.Activities {
						<div class="flex gap-3 text-[13px]">
							<span class="mt-0.5">@components.Icon(activityIcon(a.Kind), "w-4 h-4 text-ink-3")</span>
							<div class="min-w-0">
								<div class="text-ink">{ a.Subject }</div>
								<div class="text-[11.5px] text-ink-3">{ a.Who } · { a.When }</div>
							</div>
						</div>
					}
				</div>
				if len(d.Activities) == 0 {
					<p class="mt-2 text-[13px] text-ink-3">No activity yet.</p>
				}
			</div>
		</div>

		<aside class="space-y-4">
			<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
				@components.SectionTitle("Company")
				@components.KV("Website", d.Website)
				@components.KV("Domain", d.Domain)
				@components.KV("Industry", d.Industry)
				@components.KV("Location", d.Location)
				<a href={ templ.URL("/companies/" + d.CompanyID) } class="mt-2 inline-block text-[12.5px] text-brand-600 hover:underline">Open company →</a>
			</div>
			<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
				@components.SectionTitle("Lead")
				@components.KV("Status", d.Status)
				@components.KV("Owner", d.Owner)
				@components.KV("Source", d.Source)
				@components.KV("Created", d.Created)
				<form method="post" action={ templ.URL("/leads/" + d.ID) } class="mt-3 space-y-2">
					<input type="hidden" name="_token" value={ p.CSRFToken }/>
					<div class="grid grid-cols-2 gap-2">
						<select name="status" class="input h-8 rounded-lg border border-line bg-white px-2 text-[13px]">
							for _, st := range []string{"new", "qualified", "hot", "contacted", "archived"} {
								if st == d.Status {
									<option value={ st } selected>{ st }</option>
								} else {
									<option value={ st }>{ st }</option>
								}
							}
						</select>
						<select name="owner_id" class="input h-8 rounded-lg border border-line bg-white px-2 text-[13px]">
							<option value="">Owner…</option>
							for _, o := range d.Owners {
								if o.Value == d.OwnerID {
									<option value={ o.Value } selected>{ o.Label }</option>
								} else {
									<option value={ o.Value }>{ o.Label }</option>
								}
							}
						</select>
					</div>
					<button class="h-8 w-full rounded-lg bg-ink text-white text-[13px] font-medium">Update lead</button>
				</form>
			</div>
			if len(d.Enrichments) > 0 {
				<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
					@components.SectionTitle("Enrichment")
					for _, e := range d.Enrichments {
						<div class="flex items-center justify-between py-1 text-[13px]">
							<span class="text-ink-2 capitalize">{ e.Kind }</span>
							<span class="text-[12px] text-ink-3">conf. { itoa(e.Confidence) } · { e.When }</span>
						</div>
					}
				</div>
			}
			if len(d.Deals) > 0 {
				<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
					@components.SectionTitle("Deals")
					for _, dl := range d.Deals {
						<a href={ templ.URL("/deals/" + dl.ID) } class="block py-1.5 border-b border-[#f0f1f6] last:border-0">
							<div class="text-[13px] font-medium hover:text-brand-700">{ dl.Title }</div>
							<div class="text-[12px] text-ink-3">{ dl.Stage } · { dl.Value }</div>
						</a>
					}
				</div>
			}
		</aside>
	</div>
}

templ detailActions(p PageMeta, d *DetailData) {
	<div class="flex items-center gap-2">
		if d.HasEmail {
			<a href={ templ.URL("mailto:" + d.Email) } class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">
				@components.Icon("mail", "w-3.5 h-3.5") Email
			</a>
		}
		if d.HasWhatsApp {
			<a href={ templ.URL(d.WhatsAppLink) } target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">
				@components.Icon("message-circle", "w-3.5 h-3.5") WhatsApp
			</a>
		}
		<a href={ templ.URL("/tasks?lead=" + d.ID) } class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">
			@components.Icon("check-square", "w-3.5 h-3.5") Add Task
		</a>
		<a href={ templ.URL("/deals/new?lead=" + d.ID) } class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">
			@components.Icon("plus", "w-3.5 h-3.5") Add Deal
		</a>
		<form method="post" action={ templ.URL("/leads/" + d.ID + "/refresh") } class="inline">
			<input type="hidden" name="_token" value={ p.CSRFToken }/>
			<button class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">
				@components.Icon("refresh-cw", "w-3.5 h-3.5") Refresh
			</button>
		</form>
	</div>
}

func activityIcon(kind string) string {
	switch kind {
	case "lead.created":
		return "plus"
	case "lead.enriched":
		return "zap"
	case "lead.qualified":
		return "flame"
	case "email.sent", "reply.received":
		return "mail"
	case "task.created":
		return "check-square"
	case "deal.created", "deal.stage_changed", "deal.won":
		return "handshake"
	default:
		return "activity"
	}
}
