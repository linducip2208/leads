package lists

import "leadforge/web/components"

templ List(p PageMeta, d *PageData) {
	@components.PageHeader("Lists", "Manual collections — add leads from the Leads table bulk bar.")
	if d.Error != "" {
		<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-[13px] text-red-800">{ d.Error }</div>
	}
	<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
		<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden h-fit">
			<table class="tbl w-full text-[13px]">
				<thead><tr><th>Name</th><th>Description</th><th class="text-right">Members</th><th class="text-right">Actions</th></tr></thead>
				<tbody>
					for _, it := range d.Items {
						<tr>
							<td class="font-medium"><a href={ templ.URL("/lists/" + it.ID) } class="hover:text-brand-700 hover:underline">{ it.Name }</a></td>
							<td class="text-ink-2 max-w-[320px] truncate">{ it.Desc }</td>
							<td class="text-right tabular-nums">{ itoa(it.Members) }</td>
							<td class="text-right">
								<form method="post" action={ templ.URL("/lists/" + it.ID + "/delete") } class="inline" data-confirm="Delete this list? (Leads are kept.)">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<button class="h-7 px-2 rounded-md border border-line text-[12px] text-red-700 hover:bg-red-50">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(d.Items) == 0 {
				<div class="p-6 text-center text-[13px] text-ink-3">No lists yet.</div>
			}
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">New list</h2>
			<form method="post" action="/lists" class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				@components.Input("name", "Name", "", "e.g. Q3 outreach", "text", true)
				@components.Input("description", "Description", "", "", "text", false)
				<button class="h-9 w-full rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Create list</button>
			</form>
		</aside>
	</div>
}

templ Detail(p PageMeta, d *DetailData) {
	@components.PageHeader(d.List.Name, d.List.Desc)
	<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
		<div class="px-4 py-3 border-b border-line text-[13px] text-ink-2">{ itoa(d.List.Members) } members</div>
		<table class="tbl w-full text-[13px]">
			<thead><tr><th>Company</th><th>City</th><th class="text-right">Score</th><th>Status</th><th class="text-right">Actions</th></tr></thead>
			<tbody>
				for _, m := range d.Members {
					<tr class="hover:bg-[#f6f7fb]">
						<td class="font-medium" data-href={ "/leads/" + m.LeadID }>{ m.Company }</td>
						<td class="text-ink-2">{ m.City }</td>
						<td class="text-right">@components.ScoreBadge(m.Score)</td>
						<td>@components.StatusBadge(m.Status)</td>
						<td class="text-right">
							<form method="post" action={ templ.URL("/lists/" + d.List.ID + "/remove") } class="inline">
								<input type="hidden" name="_token" value={ p.CSRFToken }/>
								<input type="hidden" name="lead_id" value={ m.LeadID }/>
								<button class="h-7 px-2 rounded-md border border-line text-[12px] text-ink-2 hover:bg-[#f6f7fb]">Remove</button>
							</form>
						</td>
					</tr>
				}
			</tbody>
		</table>
		if len(d.Members) == 0 {
			<div class="p-8 text-center text-[13px] text-ink-3">Empty list — select leads in the Leads table and use the bulk bar.</div>
		}
	</div>
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	return string(b[i:])
}
