package segments

import "leadforge/web/components"

templ List(p PageMeta, d *PageData) {
	@components.PageHeader("Segments", "Dynamic groups from saved filters — e.g. Hot Leads, Has WhatsApp, Score > 80.")
	if d.Error != "" {
		<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-[13px] text-red-800">{ d.Error }</div>
	}
	<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
		<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden h-fit">
			<table class="tbl w-full text-[13px]">
				<thead><tr><th>Name</th><th>Filters</th><th class="text-right">Members</th><th class="text-right">Actions</th></tr></thead>
				<tbody>
					for _, it := range d.Items {
						<tr>
							<td class="font-medium"><a href={ templ.URL("/segments/" + it.ID) } class="hover:text-brand-700 hover:underline">{ it.Name }</a></td>
							<td class="text-ink-2 max-w-[360px] truncate">{ it.Summary }</td>
							<td class="text-right tabular-nums">{ itoa(it.Members) }</td>
							<td class="text-right">
								<form method="post" action={ templ.URL("/segments/" + it.ID + "/refresh") } class="inline">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<button class="h-7 px-2 rounded-md border border-line text-[12px] hover:bg-[#f6f7fb]">Refresh</button>
								</form>
								<form method="post" action={ templ.URL("/segments/" + it.ID + "/delete") } class="inline ml-1" data-confirm="Delete this segment?">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<button class="h-7 px-2 rounded-md border border-line text-[12px] text-red-700 hover:bg-red-50">Delete</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
			if len(d.Items) == 0 {
				<div class="p-6 text-center text-[13px] text-ink-3">No segments yet.</div>
			}
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">New segment</h2>
			<form method="post" action="/segments" class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				@components.Input("name", "Name", "", "e.g. Construction Jakarta", "text", true)
				@components.Input("industry", "Industry", "", "", "text", false)
				@components.Input("city", "City", "", "", "text", false)
				@components.Select("min_score", "Minimum score", []string{"0|Any", "50|50+", "70|70+", "80|80+", "90|90+"}, "0")
				<div class="flex gap-4">
					@components.Checkbox("has_whatsapp", "Has WhatsApp", false)
					@components.Checkbox("no_website", "No website", false)
				</div>
				<button class="h-9 w-full rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Create & evaluate</button>
			</form>
		</aside>
	</div>
}

templ Detail(p PageMeta, d *DetailData) {
	@components.PageHeader(d.Segment.Name, d.Segment.Summary)
	<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
		<div class="px-4 py-3 border-b border-line text-[13px] text-ink-2">{ itoa(d.Segment.Members) } members</div>
		<table class="tbl w-full text-[13px]">
			<thead><tr><th>Company</th><th>City</th><th class="text-right">Score</th><th>Status</th></tr></thead>
			<tbody>
				for _, m := range d.Members {
					<tr class="hover:bg-[#f6f7fb]" data-href={ "/leads/" + m.LeadID }>
						<td class="font-medium">{ m.Company }</td>
						<td class="text-ink-2">{ m.City }</td>
						<td class="text-right">@components.ScoreBadge(m.Score)</td>
						<td>@components.StatusBadge(m.Status)</td>
					</tr>
				}
			</tbody>
		</table>
		if len(d.Members) == 0 {
			<div class="p-8 text-center text-[13px] text-ink-3">No members match right now.</div>
		}
	</div>
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	return string(b[i:])
}
