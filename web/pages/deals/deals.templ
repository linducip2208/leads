package deals

import "leadforge/web/components"

templ List(p PageMeta, d *ListData) {
	@components.PageHeader("Deals", "Track every opportunity to close.") {
		@components.LinkButton("/deals/new", "New Deal")
	}
	<div class="card bg-white border border-line rounded-xl shadow-xs">
		<div class="px-4 pt-3 flex items-center gap-1.5 border-b border-line">
			for _, t := range []struct{ v, l string }{{"open", "Open"}, {"won", "Won"}, {"lost", "Lost"}, {"", "All"}} {
				if (t.v == "" && d.Status == "") || t.v == d.Status && t.v != "" {
					<a href={ templ.URL("/deals?status=" + t.v) } class="px-3 pb-2.5 text-[13px] font-semibold text-brand-700 border-b-2 border-brand-600 -mb-px">{ t.l }</a>
				} else {
					<a href={ templ.URL("/deals?status=" + t.v) } class="px-3 pb-2.5 text-[13px] font-medium text-ink-2 hover:text-ink border-b-2 border-transparent -mb-px">{ t.l }</a>
				}
			}
		</div>
		<div class="overflow-x-auto">
			<table class="tbl w-full text-[13px]">
				<thead><tr><th>Deal</th><th>Company</th><th>Stage</th><th class="text-right">Value</th><th class="text-right">Prob</th><th>Expected</th><th>Owner</th><th>Status</th></tr></thead>
				<tbody>
					for _, it := range d.Items {
						<tr class="hover:bg-[#f6f7fb]" data-href={ "/deals/" + it.ID }>
							<td class="font-medium max-w-[260px] truncate">{ it.Title }</td>
							<td class="text-ink-2 max-w-[200px] truncate">{ it.Company }</td>
							<td class="text-ink-2">{ it.Stage }</td>
							<td class="text-right font-semibold tabular-nums">{ it.Value }</td>
							<td class="text-right tabular-nums">{ itoa(it.Prob) }%</td>
							<td class="text-ink-2 whitespace-nowrap">{ it.Close }</td>
							<td class="text-ink-2">{ it.Owner }</td>
							<td>@components.StatusBadge(it.Status)</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Items) == 0 {
			<div class="p-10">@components.EmptyState("handshake", "No deals yet", "Convert a lead into a deal to start tracking revenue.", components.LinkButton("/leads", "Browse leads"))</div>
		}
	</div>
}

templ New(p PageMeta, d *NewData) {
	@components.PageHeader("New Deal", "Create an opportunity in the pipeline.")
	<div class="card bg-white border border-line rounded-xl shadow-xs p-5 max-w-2xl">
		if d.Form.Error != "" {
			<div class="mb-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-[12.5px] text-red-800">{ d.Form.Error }</div>
		}
		<form method="post" action="/deals" class="space-y-3">
			<input type="hidden" name="_token" value={ p.CSRFToken }/>
			<input type="hidden" name="lead_id" value={ d.Form.LeadID }/>
			@components.Input("title", "Title", d.Form.Title, "e.g. Website revamp — PT Maju", "text", true)
			<div class="grid grid-cols-2 gap-3">
				<div class="space-y-1.5">
					<label class="block text-[13px] font-medium text-ink-2">Company</label>
					<select name="company_id" class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px]">
						<option value="">Select…</option>
						for _, o := range d.Companies {
							if o.Value == d.Form.CompanyID {
								<option value={ o.Value } selected>{ o.Label }</option>
							} else {
								<option value={ o.Value }>{ o.Label }</option>
							}
						}
					</select>
				</div>
				<div class="space-y-1.5">
					<label class="block text-[13px] font-medium text-ink-2">Stage</label>
					<select name="stage_id" class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px]">
						for _, o := range d.Stages {
							if o.Value == d.Form.StageID {
								<option value={ o.Value } selected>{ o.Label }</option>
							} else {
								<option value={ o.Value }>{ o.Label }</option>
							}
						}
					</select>
				</div>
			</div>
			<div class="grid grid-cols-3 gap-3">
				@components.Input("value", "Value", d.Form.Value, "150000000", "number", false)
				@components.Select("currency", "Currency", []string{"IDR|IDR", "USD|USD"}, d.Form.Currency)
				@components.Input("probability", "Probability %", itoa(d.Form.Probability), "30", "number", false)
			</div>
			<div class="grid grid-cols-2 gap-3">
				@components.Input("expected_close", "Expected close", d.Form.Expected, "", "date", false)
				<div class="space-y-1.5">
					<label class="block text-[13px] font-medium text-ink-2">Owner</label>
					<select name="owner_id" class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px]">
						<option value="">Unassigned</option>
						for _, o := range d.Owners {
							<option value={ o.Value }>{ o.Label }</option>
						}
					</select>
				</div>
			</div>
			<button class="h-9 px-4 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Create deal</button>
		</form>
	</div>
}

templ Detail(p PageMeta, d *DetailData) {
	@components.PageHeader(d.Title, d.Company)
	<div class="grid gap-4 lg:grid-cols-[1fr_360px] max-w-6xl">
		<div class="space-y-4">
			<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-[22px] font-semibold tabular-nums">{ d.Value }</span>
					@components.StatusBadge(d.Status)
					<span class="text-[12.5px] text-ink-3">{ d.Stage } · { itoa(d.Prob) }% probability</span>
				</div>
				<form method="post" action={ templ.URL("/deals/" + d.ID + "/stage") } class="mt-4 flex flex-wrap gap-2">
					<input type="hidden" name="_token" value={ p.CSRFToken }/>
					for _, st := range d.Stages {
						if st.Value == d.StageID {
							<span class="h-8 px-3 inline-flex items-center rounded-lg bg-brand-50 border border-brand-200 text-brand-700 text-[13px] font-medium">{ st.Label }</span>
						} else {
							<button name="stage_id" value={ st.Value } class="h-8 px-3 rounded-lg border border-line text-[13px] text-ink-2 hover:bg-[#f6f7fb]">{ st.Label }</button>
						}
					}
				</form>
			</div>
			<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
				<h2 class="text-[14px] font-semibold">Timeline</h2>
				<div class="mt-3 space-y-3">
					for _, t := range d.Timeline {
						<div class="flex gap-3 text-[13px]">
							<span class="mt-0.5">@components.Icon("activity", "w-4 h-4 text-ink-3")</span>
							<div><div class="text-ink">{ t.Body }</div><div class="text-[11.5px] text-ink-3">{ t.Who } · { t.When }</div></div>
						</div>
					}
				</div>
				if len(d.Timeline) == 0 {
					<p class="mt-2 text-[13px] text-ink-3">No activity yet.</p>
				}
			</div>
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">Update deal</h2>
			<form method="post" action={ templ.URL("/deals/" + d.ID) } class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				@components.Input("value", "Value", d.ValueNum, "number", "number", false)
				<div class="grid grid-cols-2 gap-3">
					@components.Select("status", "Status", []string{"open|Open", "won|Won", "lost|Lost"}, d.Status)
					@components.Input("probability", "Probability %", itoa(d.Prob), "", "number", false)
				</div>
				@components.Input("expected_close", "Expected close", d.ExpectedISO, "", "date", false)
				@components.Input("lost_reason", "Lost reason", d.LostReason, "", "text", false)
				<button class="h-9 w-full rounded-lg bg-ink text-white text-[13px] font-medium">Save changes</button>
			</form>
		</aside>
	</div>
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	return string(b[i:])
}
