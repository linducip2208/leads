package tasks

import "leadforge/web/components"

templ List(p PageMeta, d *ListData) {
	@components.PageHeader("Tasks", "Follow-ups, calls and meetings — nothing slips.") {
		<button onclick="document.getElementById('task-form-card').classList.toggle('hidden')" class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">New Task</button>
	}
	<div id="task-form-card" class="card bg-white border border-line rounded-xl shadow-xs p-5 mb-4 max-w-2xl hidden">
		if d.LeadName != "" {
			<div class="mb-3 text-[13px] text-ink-2">For lead: <span class="font-medium">{ d.LeadName }</span></div>
		}
		<form method="post" action="/tasks" class="grid gap-3 sm:grid-cols-2">
			<input type="hidden" name="_token" value={ p.CSRFToken }/>
			<input type="hidden" name="lead_id" value={ d.LeadID }/>
			<div class="sm:col-span-2">@components.Input("title", "Title", "", "e.g. Call back on Tuesday", "text", true)</div>
			@components.Select("kind", "Type", []string{"call|Call", "email|Email", "whatsapp|WhatsApp", "meeting|Meeting", "follow_up|Follow-up", "general|General"}, "call")
			@components.Select("priority", "Priority", []string{"low|Low", "medium|Medium", "high|High", "urgent|Urgent"}, "medium")
			@components.Input("due_at", "Due", "", "", "datetime-local", false)
			<div class="sm:col-span-2"><button class="h-9 px-4 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Create task</button></div>
		</form>
	</div>
	<div class="card bg-white border border-line rounded-xl shadow-xs">
		<div class="px-4 pt-3 flex items-center gap-1.5 border-b border-line">
			for _, t := range []struct{ v, l string }{{"open", "Open"}, {"completed", "Completed"}, {"cancelled", "Cancelled"}, {"mine", "Mine"}, {"", "All"}} {
				if t.v == d.Filter || (t.v == "open" && d.Filter == "") {
					<a href={ templ.URL("/tasks?filter=" + t.v) } class="px-3 pb-2.5 text-[13px] font-semibold text-brand-700 border-b-2 border-brand-600 -mb-px">{ t.l }</a>
				} else {
					<a href={ templ.URL("/tasks?filter=" + t.v) } class="px-3 pb-2.5 text-[13px] font-medium text-ink-2 hover:text-ink border-b-2 border-transparent -mb-px">{ t.l }</a>
				}
			}
		</div>
		<div class="divide-y divide-[#f0f1f6]">
			for _, it := range d.Items {
				<div class="px-4 py-2.5 flex items-center gap-3">
					<form method="post" action={ templ.URL("/tasks/" + it.ID + "/toggle") } class="shrink-0">
						<input type="hidden" name="_token" value={ p.CSRFToken }/>
						<button title="Toggle done" class={ toggleCls(it.Status) }>
							if it.Status == "completed" {
								@components.Icon("check", "w-3.5 h-3.5")
							}
						</button>
					</form>
					<div class="min-w-0 flex-1">
						<div class={ titleCls(it.Status) }>{ it.Title }</div>
						<div class="text-[12px] text-ink-3">
							{ it.Kind }
							if it.LeadName != "" {
								<span> · <a href={ templ.URL("/leads/" + it.LeadID) } class="hover:text-brand-700 hover:underline">{ it.LeadName }</a></span>
							}
							if it.DealName != "" {
								<span> · <a href={ templ.URL("/deals/" + it.DealID) } class="hover:text-brand-700 hover:underline">{ it.DealName }</a></span>
							}
							if it.Assignee != "" {
								<span> · { it.Assignee }</span>
							}
						</div>
					</div>
					if it.Due != "" {
						if it.Overdue {
							<span class="text-[12px] font-medium text-red-700 shrink-0">{ it.Due }</span>
						} else {
							<span class="text-[12px] text-ink-3 shrink-0">{ it.Due }</span>
						}
					}
					@components.Badge(it.Priority, priTone(it.Priority))
					<form method="post" action={ templ.URL("/tasks/" + it.ID + "/delete") } data-confirm="Delete this task?" class="shrink-0">
						<input type="hidden" name="_token" value={ p.CSRFToken }/>
						<button class="p-1.5 rounded-md text-ink-3 hover:text-red-700 hover:bg-red-50">@components.Icon("trash-2", "w-4 h-4")</button>
					</form>
				</div>
			}
		</div>
		if len(d.Items) == 0 {
			<div class="p-10">@components.EmptyState("check-square", "No tasks", "Create follow-ups so hot leads never go cold.", nil)</div>
		}
	</div>
}

func toggleCls(status string) string {
	base := "w-5 h-5 rounded-md border flex items-center justify-center "
	if status == "completed" {
		return base + "bg-emerald-500 border-emerald-500 text-white"
	}
	return base + "border-line bg-white hover:border-brand-400"
}

func titleCls(status string) string {
	if status == "completed" {
		return "text-[13.5px] text-ink-3 line-through"
	}
	return "text-[13.5px] font-medium"
}

func priTone(p string) string {
	switch p {
	case "urgent":
		return "red"
	case "high":
		return "amber"
	case "low":
		return "gray"
	default:
		return "blue"
	}
}
