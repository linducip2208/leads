package team

import "leadforge/web/components"

templ Members(p PageMeta, d *MembersData) {
	@components.PageHeader("Members", "Who can access this workspace and with which roles.")
	if d.Error != "" {
		<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-[13px] text-red-800">{ d.Error }</div>
	}
	<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
		<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden h-fit">
			<table class="tbl w-full text-[13px]">
				<thead><tr><th>Member</th><th>Status</th><th>Roles</th><th>Joined</th><th class="text-right">Actions</th></tr></thead>
				<tbody>
					for _, m := range d.Members {
						<tr>
							<td>
								<div class="flex items-center gap-2.5">
									@components.Avatar(m.Name, 30)
									<div><div class="font-medium">{ m.Name }</div><div class="text-[11.5px] text-ink-3">{ m.Email }</div></div>
								</div>
							</td>
							<td>@components.StatusBadge(m.Status)</td>
							<td class="text-ink-2 max-w-[220px] truncate">{ m.Roles }</td>
							<td class="text-ink-3 whitespace-nowrap">{ m.Joined }</td>
							<td class="text-right whitespace-nowrap">
								<form method="post" action={ templ.URL("/settings/members/" + m.ID + "/role") } class="inline">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<select name="role_id" onchange="this.form.submit()" class="input h-7 rounded-md border border-line bg-white px-1.5 text-[12px]">
										<option value="">Set role…</option>
										for _, r := range d.Roles {
											<option value={ r.Value }>{ r.Label }</option>
										}
									</select>
								</form>
								<form method="post" action={ templ.URL("/settings/members/" + m.ID + "/toggle") } class="inline ml-1">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<button class="h-7 px-2 rounded-md border border-line text-[12px] hover:bg-[#f6f7fb]">Suspend/Activate</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">Add member</h2>
			<form method="post" action="/settings/members" class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				@components.Input("name", "Name", "", "", "text", true)
				@components.Input("email", "Email", "", "", "email", true)
				@components.Input("password", "Password (min 8, share out-of-band)", "", "", "password", true)
				<div class="space-y-1.5">
					<label class="block text-[13px] font-medium text-ink-2">Role</label>
					<select name="role_id" class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px]">
						for _, r := range d.Roles {
							<option value={ r.Value }>{ r.Label }</option>
						}
					</select>
				</div>
				<button class="h-9 w-full rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Add member</button>
			</form>
		</aside>
	</div>
}

templ Roles(p PageMeta, d *RolesData) {
	@components.PageHeader("Roles", "System roles are read-only; create tenant roles for custom access.")
	if d.Error != "" {
		<div class="mb-4 rounded-lg border border-red-200 bg-red-50 px-3.5 py-2.5 text-[13px] text-red-800">{ d.Error }</div>
	}
	<div class="grid gap-4 lg:grid-cols-[1fr_380px]">
		<div class="space-y-3">
			for _, r := range d.Roles {
				<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
					<div class="flex items-center gap-2">
						<span class="text-[14px] font-semibold">{ r.Name }</span>
						if r.System {
							@components.Badge("system", "gray")
						}
						<span class="text-[12px] text-ink-3">{ itoa(r.Members) } members</span>
						if !r.System {
							<form method="post" action={ templ.URL("/settings/roles/" + r.ID + "/delete") } class="ml-auto" data-confirm="Delete this role? Members lose its permissions.">
								<input type="hidden" name="_token" value={ p.CSRFToken }/>
								<button class="text-[12px] text-red-700 hover:underline">Delete</button>
							</form>
						}
					</div>
					<div class="mt-2 flex flex-wrap gap-1.5">
						for _, pm := range r.Perms {
							<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[11px] border bg-gray-50 text-gray-600 border-gray-200">{ pm }</span>
						}
					</div>
				</div>
			}
		</div>
		<aside class="card bg-white border border-line rounded-xl shadow-xs p-4 h-fit">
			<h2 class="text-[14px] font-semibold mb-3">New tenant role</h2>
			<form method="post" action="/settings/roles" class="space-y-3">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				@components.Input("name", "Name", "", "e.g. SDR", "text", true)
				@components.Input("slug", "Slug", "", "e.g. sdr", "text", true)
				<div class="space-y-1.5">
					<div class="text-[13px] font-medium text-ink-2">Permissions</div>
					<div class="grid grid-cols-1 gap-1 max-h-64 overflow-y-auto scroll-thin">
						for _, pm := range d.Perms {
							<label class="inline-flex items-center gap-2 text-[12.5px] text-ink-2 cursor-pointer">
								<input type="checkbox" name="perms" value={ pm } class="w-3.5 h-3.5 accent-brand-600"/>
								{ pm }
							</label>
						}
					</div>
				</div>
				<button class="h-9 w-full rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">Create role</button>
			</form>
		</aside>
	</div>
}

func itoa(n int) string {
	if n == 0 {
		return "0"
	}
	var b [20]byte
	i := len(b)
	for n > 0 {
		i--
		b[i] = byte('0' + n%10)
		n /= 10
	}
	return string(b[i:])
}
