package searches

import (
	"strconv"

	"leadforge/web/components"
)

func ftoa(f float64) string {
	return strconv.FormatFloat(f, 'f', 1, 64)
}

templ Detail(p PageMeta, d *DetailData) {
	@components.PageHeader(d.Search.Query, d.Search.Industry+" · "+d.Search.Location) { @searchActions(p, d) }
	<div class="grid gap-4 lg:grid-cols-[1fr_360px]">
		<div class="space-y-4 min-w-0">
			<div class="card bg-white border border-line rounded-xl shadow-xs p-5">
				<div class="flex items-center justify-between gap-2">
					<h2 class="text-[14px] font-semibold">Search Progress</h2>
					@components.StatusBadge(d.Search.Status)
				</div>
				<div class="mt-1 text-[13px] text-ink-2"><span id="sp-count" class="font-semibold text-ink tabular-nums">{ num(int(d.Progress.Saved)) }</span> / { num(d.Progress.Limit) }</div>
				<div class="mt-2 h-2.5 rounded-full bg-[#eef0f5] overflow-hidden">
					<div id="sp-bar" class="h-full rounded-full bg-brand-600 transition-all" style={ "width:" + pct(d.Progress.Saved, d.Progress.Limit) + "%" }></div>
				</div>
				<div class="mt-4 space-y-1.5">
					for _, fs := range d.Funnel {
						<div class="flex items-center gap-2 text-[12.5px]">
							<span class="w-24 shrink-0 text-ink-3">{ fs.Label }</span>
							<div class="flex-1 h-1.5 rounded-full bg-[#eef0f5] overflow-hidden">
								<div class="h-full rounded-full bg-brand-500" style={ "width:" + pct(int64(fs.Value), int(funnelMax(d.Funnel))) + "%" }></div>
							</div>
							<span class="w-14 text-right font-semibold tabular-nums">{ num(fs.Value) }</span>
						</div>
					}
				</div>
				<div class="mt-3 grid grid-cols-3 gap-2.5 text-center">
					<div class="rounded-lg border border-line p-2"><div class="text-[10.5px] uppercase tracking-wide text-ink-3">Filtered</div><div class="text-[15px] font-semibold tabular-nums">{ num(int(d.Progress.Filtered)) }</div></div>
					<div class="rounded-lg border border-line p-2"><div class="text-[10.5px] uppercase tracking-wide text-ink-3">Hot</div><div class="text-[15px] font-semibold tabular-nums">{ num(int(d.Progress.Hot)) }</div></div>
					<div class="rounded-lg border border-line p-2"><div class="text-[10.5px] uppercase tracking-wide text-ink-3">Failed</div><div class="text-[15px] font-semibold tabular-nums"><span id="sp-failed">{ num(int(d.Progress.Failed)) }</span></div></div>
				</div>
				if len(d.Failures) > 0 {
					<div class="mt-3">
						<div class="text-[11.5px] font-semibold uppercase tracking-wide text-ink-3 mb-1.5">Failure breakdown</div>
						<div class="flex flex-wrap gap-1.5">
							for _, fb := range d.Failures {
								<span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium border bg-red-50 text-red-700 border-red-200">{ fb.Reason } · { num(fb.Count) }</span>
							}
						</div>
					</div>
				}
				if d.Progress.Error != "" {
					<div class="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-[12.5px] text-red-800">{ d.Progress.Error }</div>
				}
			</div>

			<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
				<div class="px-4 py-3 border-b border-line flex items-center justify-between">
					<h2 class="text-[14px] font-semibold">Live discoveries</h2>
					<span class="text-[11.5px] text-ink-3">auto-refresh</span>
				</div>
				<div hx-get={ "/searches/" + d.Search.ID + "/latest" } hx-trigger="every 5s" hx-swap="innerHTML">
					@LatestRows(latestSeed(d))
				</div>
			</div>

			<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
				<div class="px-4 py-3 border-b border-line flex items-center justify-between">
					<h2 class="text-[14px] font-semibold">Top results</h2>
					<a href={ templ.URL("/leads?search=" + d.Search.ID) } class="text-[12.5px] text-brand-600 hover:text-brand-700">View all in Leads →</a>
				</div>
				<div class="overflow-x-auto">
					<table class="tbl w-full text-[13px]">
						<thead><tr><th>Company</th><th>City</th><th class="text-right">Score</th><th>Status</th></tr></thead>
						<tbody>
							for _, r := range d.Results {
								<tr class="hover:bg-[#f6f7fb] cursor-pointer" data-href={ "/leads/" + r.LeadID }>
									<td class="font-medium">{ r.Company }</td>
									<td class="text-ink-2">{ r.City }</td>
									<td class="text-right">@components.ScoreBadge(r.Score)</td>
									<td>@components.StatusBadge(r.Status)</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
				if len(d.Results) == 0 {
					<div class="p-8 text-center text-[13px] text-ink-3">No qualified results yet — the worker may still be crawling.</div>
				}
			</div>
		</div>

		<aside class="space-y-4">
			<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
				@components.SectionTitle("Details")
				@components.KV("Requested", num(d.Search.Requested))
				@components.KV("Industry", d.Search.Industry)
				@components.KV("Location", d.Search.Location)
				@components.KV("Created", d.Search.Created)
				@components.KV("Duration", d.Search.Duration)
				@components.KV("Created by", d.Search.CreatedBy)
			</div>
			<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
				@components.SectionTitle("Result quality")
				@components.KV("Avg score", ftoa(d.Quality.AvgScore))
				@components.KV("Hot share", ftoa(d.Quality.HotPct)+"%")
				@components.KV("Contactable", ftoa(d.Quality.ContactablePct)+"%")
				if len(d.Quality.TopIndustries) > 0 {
					<div class="mt-2 text-[12px] font-medium text-ink-2">Top industries</div>
					for _, t := range d.Quality.TopIndustries {
						<div class="text-[12.5px] text-ink-3">· { t }</div>
					}
				}
				if len(d.Quality.TopCities) > 0 {
					<div class="mt-2 text-[12px] font-medium text-ink-2">Top cities</div>
					for _, t := range d.Quality.TopCities {
						<div class="text-[12.5px] text-ink-3">· { t }</div>
					}
				}
			</div>
			if len(d.Sources) > 0 {
				<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
					@components.SectionTitle("Sources (debug)")
					for _, s := range d.Sources {
						<div class="py-1.5 border-b border-[#f0f1f6] last:border-0 text-[12.5px]">
							<div class="font-medium">{ s.Slug }</div>
							<div class="text-ink-3">{ num(s.Candidates) } cand · { num(s.Accepted) } in · { num(s.Errors) } err</div>
							if s.LastError != "" {
								<div class="text-red-700 break-words">{ s.LastError }</div>
							}
						</div>
					}
				</div>
			}
		</aside>
	</div>
	<script>
	(function () {
		var id = { strconv.Quote(d.Search.ID) };
		var terminal = { strconv.Quote(d.Search.Status) } === "completed" || { strconv.Quote(d.Search.Status) } === "failed" || { strconv.Quote(d.Search.Status) } === "cancelled";
		if (terminal || !window.EventSource) return;
		var es = new EventSource("/searches/" + id + "/events");
		function fmt(n) { return Number(n).toLocaleString("en-US"); }
		es.addEventListener("progress", function (ev) {
			try {
				var p = JSON.parse(ev.data);
				var set = function (sid, v) { var el = document.getElementById(sid); if (el) el.textContent = fmt(v); };
				set("sp-found", p.found); set("sp-saved", p.saved); set("sp-dup", p.duplicate);
				set("sp-crawled", p.crawled); set("sp-enriched", p.enriched);
				set("sp-qualified", p.qualified); set("sp-failed", p.failed);
				set("sp-count", p.saved);
				var bar = document.getElementById("sp-bar");
				if (bar && p.limit > 0) bar.style.width = Math.min(100, p.saved / p.limit * 100) + "%";
				if (p.status === "completed" || p.status === "failed" || p.status === "cancelled") {
					es.close();
					setTimeout(function () { location.reload(); }, 1200);
				}
			} catch (e) {}
		});
	})();
	</script>
}

templ statTile(label string, v int64, spanID string) {
	<div class="rounded-lg border border-line p-2.5">
		<div class="text-[10.5px] uppercase tracking-wide text-ink-3">{ label }</div>
		<div class="mt-0.5 text-[17px] font-semibold tabular-nums"><span id={ spanID }>{ num(int(v)) }</span></div>
	</div>
}

templ searchActions(p PageMeta, d *DetailData) {
	<div class="flex items-center gap-2">
		if d.Search.Status == "running" {
			<form method="post" action={ templ.URL("/searches/" + d.Search.ID + "/pause") }>
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				<button class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">
					@components.Icon("pause", "w-3.5 h-3.5") Pause
				</button>
			</form>
		}
		if d.Search.Status == "paused" || d.Search.Status == "queued" {
			<form method="post" action={ templ.URL("/searches/" + d.Search.ID + "/resume") }>
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				<button class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium hover:bg-[#f6f7fb]">
					@components.Icon("play", "w-3.5 h-3.5") Resume
				</button>
			</form>
		}
		if d.Search.Status == "running" || d.Search.Status == "paused" || d.Search.Status == "queued" {
			<form method="post" action={ templ.URL("/searches/" + d.Search.ID + "/cancel") } data-confirm="Cancel this search? Processed leads are kept.">
				<input type="hidden" name="_token" value={ p.CSRFToken }/>
				<button class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-red-200 text-[13px] font-medium text-red-700 hover:bg-red-50">
					@components.Icon("square", "w-3.5 h-3.5") Cancel
				</button>
			</form>
		}
		<form method="post" action={ templ.URL("/searches/" + d.Search.ID + "/save") }>
			<input type="hidden" name="_token" value={ p.CSRFToken }/>
			<button class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-brand-600 text-white text-[13px] font-medium hover:bg-brand-700">
				@components.Icon("bookmark", "w-3.5 h-3.5") Save
			</button>
		</form>
	</div>
}

func funnelMax(f []FunnelStep) int {
	max := 1
	for _, s := range f {
		if s.Value > max {
			max = s.Value
		}
	}
	return max
}

func latestSeed(d *DetailData) []LatestRow {
	var out []LatestRow
	for i, r := range d.Results {
		if i >= 5 {
			break
		}
		out = append(out, LatestRow{LeadID: r.LeadID, Company: r.Company, Score: r.Score})
	}
	return out
}

func pct(part int64, total int) string {	if total <= 0 {
		return "0"
	}
	v := float64(part) / float64(total) * 100
	if v > 100 {
		v = 100
	}
	return strconv.FormatFloat(v, 'f', 1, 64)
}

templ LatestRows(items []LatestRow) {
	for _, r := range items {
		<a href={ templ.URL("/leads/" + r.LeadID) } class="flex items-center justify-between px-3 py-2 border-b border-[#f0f1f6] last:border-0 hover:bg-[#f6f7fb]">
			<span class="text-[12.5px] font-medium truncate">{ r.Company }</span>
			<span class="flex items-center gap-2 shrink-0">
				<span class="text-[11px] text-ink-3 tabular-nums">{ r.When }</span>
				@components.ScoreBadge(r.Score)
			</span>
		</a>
	}
}
