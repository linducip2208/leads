package searches

import "leadforge/web/components"

templ Saved(p PageMeta, d *SavedData) {
	@components.PageHeader("Saved Searches", "Reusable finder presets — run them again anytime.") { @components.LinkButton("/finder", "New Search") }
	<div class="card bg-white border border-line rounded-xl shadow-xs overflow-hidden">
		<div class="overflow-x-auto">
			<table class="tbl w-full text-[13px]">
				<thead><tr><th>Name</th><th>Preset</th><th>Saved</th><th class="text-right">Actions</th></tr></thead>
				<tbody>
					for _, it := range d.Items {
						<tr>
							<td class="font-medium">{ it.Name }</td>
							<td class="text-ink-2 max-w-[420px] truncate">{ it.Summary }</td>
							<td class="text-ink-3 whitespace-nowrap">{ it.Created }</td>
							<td class="text-right whitespace-nowrap">
								<form method="post" action={ templ.URL("/saved-searches/" + it.ID + "/run") } class="inline">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<button class="inline-flex items-center gap-1 h-7 px-2.5 rounded-lg bg-brand-600 text-white text-xs font-medium hover:bg-brand-700">
										@components.Icon("play", "w-3 h-3") Run
									</button>
								</form>
								<form method="post" action={ templ.URL("/saved-searches/" + it.ID + "/delete") } class="inline ml-1" data-confirm="Delete this saved search?">
									<input type="hidden" name="_token" value={ p.CSRFToken }/>
									<button class="inline-flex items-center h-7 px-2 rounded-lg border border-line text-xs text-ink-2 hover:bg-[#f6f7fb]">
										@components.Icon("trash-2", "w-3.5 h-3.5")
									</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		if len(d.Items) == 0 {
			<div class="p-10">
				@components.EmptyState("bookmark", "No saved searches", "Open any search and click Save to reuse its filters later.", components.LinkButton("/searches", "Browse history"))
			</div>
		}
	</div>
}
