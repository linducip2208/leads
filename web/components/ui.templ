package components

import "fmt"
import "strconv"

// UI primitive components: buttons, inputs, badges, cards, etc.

type BtnVariant string

const (
	BtnPrimary   BtnVariant = "primary"
	BtnSecondary BtnVariant = "secondary"
	BtnGhost     BtnVariant = "ghost"
	BtnDanger    BtnVariant = "danger"
)

type BtnSize string

const (
	BtnSm BtnSize = "sm"
	BtnMd BtnSize = "md"
)

// Btn renders a button (or anchor when href set). attrs may be nil.
templ Btn(label string, variant BtnVariant, size BtnSize, href string, attrs templ.Attributes) {
	{{ cls := btnClass(variant, size) }}
	if href != "" {
		<a href={ templ.URL(href) } class={ cls }{ attrs... }>{ templ.EscapeString(label) }</a>
	} else {
		<button type="submit" class={ cls }{ attrs... }>{ templ.EscapeString(label) }</button>
	}
}

func btnClass(v BtnVariant, s BtnSize) string {
	base := "inline-flex items-center justify-center gap-1.5 rounded-lg font-medium transition-colors select-none disabled:opacity-50 disabled:pointer-events-none focus-visible:outline-2 focus-visible:outline-brand-500 focus-visible:outline-offset-2"
	sizeCls := "h-9 px-3.5 text-[13px]"
	if s == BtnSm {
		sizeCls = "h-7 px-2.5 text-xs"
	}
	var color string
	switch v {
	case BtnPrimary:
		color = "bg-brand-600 text-white hover:bg-brand-700 shadow-xs"
	case BtnSecondary:
		color = "bg-white text-ink border border-line hover:bg-[#f6f7fb] shadow-xs dark:bg-[#171b26] dark:border-[#2a3242] dark:hover:bg-[#1c2230]"
	case BtnGhost:
		color = "text-ink-2 hover:bg-[#f0f1f6] hover:text-ink dark:hover:bg-[#1c2230]"
	case BtnDanger:
		color = "bg-red-600 text-white hover:bg-red-700 shadow-xs"
	}
	return base + " " + sizeCls + " " + color
}

// Badge variants.
func BadgeCls(tone string) string {
	base := "inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-[11px] font-medium border"
	switch tone {
	case "green":
		return base + " bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-300 dark:border-emerald-900"
	case "red":
		return base + " bg-red-50 text-red-700 border-red-200 dark:bg-red-950/40 dark:text-red-300 dark:border-red-900"
	case "amber":
		return base + " bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-900"
	case "blue":
		return base + " bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/40 dark:text-blue-300 dark:border-blue-900"
	case "gray":
		return base + " bg-gray-50 text-gray-600 border-gray-200 dark:bg-gray-900 dark:text-gray-300 dark:border-gray-700"
	default: // brand
		return base + " bg-brand-50 text-brand-700 border-brand-200 dark:bg-brand-950/40 dark:text-brand-300 dark:border-brand-900"
	}
}

templ Badge(text string, tone string) {
	<span class={ BadgeCls(tone) }>{ text }</span>
}

// ScoreBadge renders lead score: 90-100 hot, 70-89 strong, 50-69 medium, else low.
templ ScoreBadge(score int) {
	{{ tone, label := scoreTone(score) }}
	<span class={ BadgeCls(tone) + " tabular-nums" }>
		{ strconv.Itoa(score) } · { label }
	</span>
}

func scoreTone(score int) (tone, label string) {
	switch {
	case score >= 90:
		return "red", "Hot"
	case score >= 70:
		return "brand", "Strong"
	case score >= 50:
		return "amber", "Medium"
	default:
		return "gray", "Low"
	}
}

// Input renders a labeled text input.
templ Input(name, label, value, placeholder, inputType string, required bool) {
	<div class="space-y-1.5">
		if label != "" {
			<label for={ name } class="block text-[13px] font-medium text-ink-2">{ label }</label>
		}
		<input
			type={ inputType }
			id={ name }
			name={ name }
			value={ value }
			placeholder={ placeholder }
			class="input h-9 w-full rounded-lg border border-line bg-white px-3 text-[13px] text-ink placeholder:text-ink-3 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 focus:outline-none"
			required?={ required }
		/>
	</div>
}

// Select renders a labeled select with options (value|label pairs).
templ Select(name, label string, options []string, selected string) {
	<div class="space-y-1.5">
		if label != "" {
			<label for={ name } class="block text-[13px] font-medium text-ink-2">{ label }</label>
		}
		<select
			id={ name }
			name={ name }
			class="input h-9 w-full rounded-lg border border-line bg-white px-2.5 text-[13px] text-ink focus:border-brand-400 focus:ring-2 focus:ring-brand-100 focus:outline-none">
			for _, opt := range options {
				{{ val, lab := splitOpt(opt) }}
				if val == selected {
					<option value={ val } selected>{ lab }</option>
				} else {
					<option value={ val }>{ lab }</option>
				}
			}
		</select>
	</div>
}

func splitOpt(s string) (val, lab string) {
	for i := 0; i < len(s); i++ {
		if s[i] == '|' {
			return s[:i], s[i+1:]
		}
	}
	return s, s
}

// Checkbox renders a styled checkbox with label.
templ Checkbox(name, label string, checked bool) {
	<label class="inline-flex items-center gap-2 text-[13px] text-ink-2 cursor-pointer select-none">
		<input type="checkbox" name={ name } value="1" class="w-4 h-4 rounded border-line text-brand-600 accent-brand-600" checked?={ checked }/>
		{ label }
	</label>
}

// Card is a white surface panel.
templ Card() {
	<div class="card bg-white border border-line rounded-xl shadow-xs">{ children... }</div>
}

// CardHeader with optional action link.
templ CardHeader(title, subtitle string, action templ.Component) {
	<div class="flex items-start justify-between px-4 pt-4 pb-2">
		<div>
			<h3 class="text-[13px] font-semibold text-ink">{ title }</h3>
			if subtitle != "" {
				<p class="text-xs text-ink-3 mt-0.5">{ subtitle }</p>
			}
		</div>
		if action != nil {
			@action
		}
	</div>
}

// MetricCard: label, value, delta with trend icon, sparkline optional.
templ MetricCard(label, value string, deltaPct float64, invertTrend bool, spark []float64) {
	<div class="card bg-white border border-line rounded-xl shadow-xs p-4">
		<div class="flex items-center justify-between">
			<span class="text-[12px] font-medium text-ink-3">{ label }</span>
			if deltaPct != 0 {
				{{ tone := "green"; icon := "trending-up" }}
				{{ if (deltaPct < 0) == !invertTrend && deltaPct < 0 { tone = "red"; icon = "trending-down" } }}
				<span class={ BadgeCls(tone) + " tabular-nums" }>
					@Icon(icon, "w-3 h-3")
					{ fmt.Sprintf("%+.1f%%", deltaPct) }
				</span>
			}
		</div>
		<div class="mt-1.5 text-[26px] font-semibold tracking-tight leading-8 text-ink tabular-nums">{ value }</div>
		if len(spark) > 1 {
			<div class="mt-2">
				@Sparkline(spark, 180, 32)
			</div>
		}
	</div>
}

// Sparkline renders a tiny server-side SVG line chart.
templ Sparkline(points []float64, w, h int) {
	{{ path := sparkPath(points, w, h) }}
	<svg width={ strconv.Itoa(w) } height={ strconv.Itoa(h) } viewBox={ fmt.Sprintf("0 0 %d %d", w, h) } class="w-full" preserveAspectRatio="none" fill="none">
		<path d={ path } stroke="#4f46e5" stroke-width="1.5" stroke-linecap="round" fill="none"></path>
		<path d={ path + fmt.Sprintf(" L %d %d L 0 %d Z", w, h, h) } fill="#4f46e5" opacity="0.07" stroke="none"></path>
	</svg>
}

func sparkPath(points []float64, w, h int) string {
	if len(points) < 2 {
		return ""
	}
	min, max := points[0], points[0]
	for _, p := range points {
		if p < min {
			min = p
		}
		if p > max {
			max = p
		}
	}
	span := max - min
	if span == 0 {
		span = 1
	}
	px := float64(w) / float64(len(points)-1)
	var path string
	for i, p := range points {
		x := float64(i) * px
		y := float64(h) - 2 - ((p - min) / span) * float64(h-4)
		if i == 0 {
			path = fmt.Sprintf("M %.1f %.1f", x, y)
		} else {
			path += fmt.Sprintf(" L %.1f %.1f", x, y)
		}
	}
	return path
}

// EmptyState shows icon + message + CTA when lists are empty.
templ EmptyState(icon, title, description string, cta templ.Component) {
	<div class="flex flex-col items-center justify-center text-center py-14 px-6">
		<div class="w-11 h-11 rounded-xl bg-brand-50 text-brand-600 flex items-center justify-center border border-brand-100">
			@Icon(icon, "w-5 h-5")
		</div>
		<h3 class="mt-3 text-[15px] font-semibold text-ink">{ title }</h3>
		<p class="mt-1 text-[13px] text-ink-3 max-w-sm">{ description }</p>
		if cta != nil {
			<div class="mt-4">@cta</div>
		}
	</div>
}

// Skeleton loading block.
templ Skeleton(w, h string) {
	<div class={ "animate-pulse rounded-lg bg-[#eef0f5] dark:bg-[#1a2030]" } style={ "width:"+w+"; height:"+h }></div>
}

// Progress bar with label.
templ Progress(pct float64, label string) {
	<div>
		<div class="h-1.5 w-full rounded-full bg-[#eceef4] overflow-hidden dark:bg-[#1c2230]">
			<div class="h-full rounded-full bg-brand-600 transition-all" style={ fmt.Sprintf("width: %.1f%%", pct) }></div>
		</div>
	</div>
}

// Avatar with initials fallback.
templ Avatar(name string, size int) {
	{{ initials := initialsOf(name) }}
	{{ sz := fmt.Sprintf("%dpx", size) }}
	<span class="inline-flex items-center justify-center rounded-full bg-brand-100 text-brand-700 font-semibold select-none" style={ "width:"+sz+"; height:"+sz+"; font-size:"+fmt.Sprintf("%dpx", size*4/10) }>
		{ initials }
	</span>
}

func initialsOf(name string) string {
	rs := []rune(name)
	if len(rs) == 0 {
		return "?"
	}
	// take first letter of up to two words
	var out []rune
	space := true
	for _, r := range rs {
		if space && r != ' ' {
			out = append(out, r)
			if len(out) == 2 {
				break
			}
		}
		space = r == ' ' || r == '.' || r == '-'
	}
	if len(out) == 0 {
		return string(rs[0])
	}
	return string(out)
}

// Pagination for tables.
templ Pagination(page, perPage, total int, hxFragment string) {
	{{ pages := (total + perPage - 1) / perPage }}
	{{ if pages < 1 { pages = 1 } }}
	<div class="flex items-center justify-between px-4 py-3 border-t border-line text-[13px] text-ink-3">
		<span>
			{ fmt.Sprintf("%d", (page-1)*perPage+1) }–{ fmt.Sprintf("%d", min(total, page*perPage)) } of { fmt.Sprintf("%d", total) }
		</span>
		<div class="flex items-center gap-1.5">
			if page > 1 {
				if hxFragment != "" {
					<a href={ templ.URL(fmt.Sprintf("%s?page=%d", hxFragment, page-1)) } class="btn-page">← Prev</a>
				}
			}
			<span class="px-2 tabular-nums">Page { fmt.Sprintf("%d", page) } / { fmt.Sprintf("%d", pages) }</span>
			if page < pages {
				if hxFragment != "" {
					<a href={ templ.URL(fmt.Sprintf("%s?page=%d", hxFragment, page+1)) } class="btn-page">Next →</a>
				}
			}
		</div>
	</div>
}

// Tabs (server-rendered links).
templ Tabs(tabs []string, active string, base string) {
	<div class="flex items-center gap-1 border-b border-line -mb-px overflow-x-auto scroll-thin">
		for _, t := range tabs {
			{{ href := base + "?tab=" + tabSlug(t) }}
			if t == active {
				<a href={ templ.URL(href) } class="px-3 py-2 text-[13px] font-medium text-ink border-b-2 border-brand-600 -mb-px whitespace-nowrap">{ t }</a>
			} else {
				<a href={ templ.URL(href) } class="px-3 py-2 text-[13px] text-ink-3 hover:text-ink whitespace-nowrap">{ t }</a>
			}
		}
	</div>
}

func tabSlug(s string) string {
	out := make([]rune, 0, len(s))
	for _, r := range s {
		if r >= 'A' && r <= 'Z' {
			r = r + 32
		}
		if r == ' ' {
			r = '_'
		}
		out = append(out, r)
	}
	return string(out)
}

func min(a, b int) int {
	if a < b {
		return a
	}
	return b
}
