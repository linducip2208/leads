package components

// Shared page-level components used across finder, leads, CRM and admin.

// PageHeader renders title + description; actions go in the children block.
templ PageHeader(title, desc string) {
	<div class="mb-5 flex flex-wrap items-start justify-between gap-3">
		<div class="min-w-0">
			<h1 class="text-[20px] font-semibold tracking-tight text-ink">{ title }</h1>
			if desc != "" {
				<p class="mt-1 text-[13px] text-ink-3">{ desc }</p>
			}
		</div>
		<div class="flex items-center gap-2 shrink-0">{ children... }</div>
	</div>
}

// Textarea renders a labeled textarea.
templ Textarea(name, label, value, placeholder string, rows int) {
	<div class="space-y-1.5">
		if label != "" {
			<label for={ name } class="block text-[13px] font-medium text-ink-2">{ label }</label>
		}
		<textarea
			id={ name }
			name={ name }
			rows={ itoaAttr(rows) }
			placeholder={ placeholder }
			class="input w-full rounded-lg border border-line bg-white px-3 py-2 text-[13px] text-ink placeholder:text-ink-3 focus:border-brand-400 focus:ring-2 focus:ring-brand-100 focus:outline-none">{ value }</textarea>
	</div>
}

func itoaAttr(n int) string {
	if n <= 0 {
		return "3"
	}
	return itoaLib(n)
}

// StatusBadge maps entity statuses to badge tones.
templ StatusBadge(status string) {
	@Badge(statusLabel(status), statusTone(status))
}

func statusTone(s string) string {
	switch s {
	case "hot", "won", "completed", "valid", "connected", "running", "active", "replied", "sent":
		return "green"
	case "qualified", "strong", "paused", "scheduled", "pending", "medium", "draft":
		return "amber"
	case "failed", "lost", "invalid", "bounced", "error", "cancelled", "archived", "unsubscribed":
		return "red"
	case "new", "contacted", "open", "queued":
		return "blue"
	default:
		return "gray"
	}
}

func statusLabel(s string) string {
	if s == "" {
		return "—"
	}
	return capitalizeLib(s)
}

// Drawer renders a right side drawer shell; content is swapped via HTMX.
templ Drawer(id, title string, content templ.Component) {
	<div id={ id } class="drawer fixed inset-y-0 right-0 z-50 w-full max-w-[480px] translate-x-full transition-transform duration-200 flex flex-col bg-white border-l border-line shadow-xl" role="dialog" aria-modal="true">
		<div class="h-14 shrink-0 flex items-center justify-between gap-2 px-4 border-b border-line">
			<h2 class="text-[15px] font-semibold tracking-tight truncate">{ title }</h2>
			<button type="button" data-drawer-close class="p-2 -mr-1 rounded-md text-ink-3 hover:text-ink hover:bg-[#f0f1f6]">
				@Icon("x", "w-4 h-4")
			</button>
		</div>
		<div id={ id + "-body" } class="flex-1 overflow-y-auto scroll-thin p-4">
			@content
		</div>
	</div>
	<div id={ id + "-backdrop" } data-drawer-close class="drawer-backdrop hidden fixed inset-0 z-40 bg-black/30"></div>
}

// DrawerPlaceholder is the empty drawer target present on list pages.
templ DrawerHost() {
	<div id="drawer-host"></div>
}

// KV renders a label/value row for detail pages.
templ KV(label, value string) {
	<div class="flex items-start justify-between gap-3 py-1.5 text-[13px]">
		<span class="text-ink-3 shrink-0">{ label }</span>
		if value != "" {
			<span class="text-ink text-right break-words min-w-0">{ value }</span>
		} else {
			<span class="text-ink-3">—</span>
		}
	</div>
}

// SectionTitle renders a small detail section heading.
templ SectionTitle(title string) {
	<h3 class="text-[12px] font-semibold uppercase tracking-wider text-ink-3 mt-5 mb-2 first:mt-0">{ title }</h3>
}

// LinkButton renders a small secondary anchor.
templ LinkButton(href, label string) {
	<a href={ templ.URL(href) } class="inline-flex items-center gap-1.5 h-8 px-3 rounded-lg bg-white border border-line text-[13px] font-medium text-ink hover:bg-[#f6f7fb] shadow-xs">
		{ label }
	</a>
}
