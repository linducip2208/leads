package layouts

import "leadforge/internal/webapp"

// UnsubPage renders the public one-click unsubscribe confirmation.
templ UnsubPage(d *webapp.Renderer, token, email string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>Unsubscribe · { d.AppName }</title>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="h-full antialiased bg-canvas flex items-center justify-center p-6">
		<div class="card bg-white border border-line rounded-xl shadow-xs p-6 w-full max-w-sm text-center">
			<div class="mx-auto w-10 h-10 rounded-lg bg-brand-600 text-white flex items-center justify-center text-[15px] font-bold">L</div>
			<h1 class="mt-3 text-[17px] font-semibold">Unsubscribe?</h1>
			<p class="mt-1.5 text-[13px] text-ink-3">Stop all campaign emails to <span class="font-medium text-ink">{ email }</span>.</p>
			<form method="post" action={ templ.URL("/u/" + token) } class="mt-4">
				<button class="h-9 w-full rounded-lg bg-ink text-white text-[13px] font-medium">Yes, unsubscribe me</button>
			</form>
		</div>
	</body>
	</html>
}

// UnsubDone confirms the unsubscribe.
templ UnsubDone(d *webapp.Renderer) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>Unsubscribed · { d.AppName }</title>
		<link rel="stylesheet" href="/static/css/app.css"/>
	</head>
	<body class="h-full antialiased bg-canvas flex items-center justify-center p-6">
		<div class="card bg-white border border-line rounded-xl shadow-xs p-6 w-full max-w-sm text-center">
			<h1 class="text-[17px] font-semibold">You're unsubscribed</h1>
			<p class="mt-1.5 text-[13px] text-ink-3">You won't receive campaign emails anymore.</p>
		</div>
	</body>
	</html>
}
